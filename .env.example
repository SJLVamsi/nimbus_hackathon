# Copy to .env and fill in one provider to enable live LLM calls.
# Without a key the app runs in deterministic fallback mode (demo still works).

# OpenAI or any OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (takes priority if set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional: database location
# HANDOFF_DB=./handoff.db
